# VITE_API_URL: Optional custom API base URL for external client requests (e.g., http://localhost:3000)
VITE_API_URL=

# MONGODB_URI: Connection string for MongoDB Atlas database to persist CRUD prediction records
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/emipredict?retryWrites=true&w=majority

# ADMIN_TOKEN: Secret bearer token to authorize access to /api/records CRUD endpoints (required for Admin Page)
ADMIN_TOKEN=

# DagsHub Remote MLflow Tracking Credentials (used in Colab / Python notebooks & CLI)
DAGSHUB_MLFLOW_URI=https://dagshub.com/<username>/emipredict-ai.mlflow
DAGSHUB_USERNAME=
DAGSHUB_TOKEN=
